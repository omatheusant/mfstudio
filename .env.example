# Supabase project settings (Project Settings → API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — see src/lib/supabase/admin.ts.
# Required starting Fase 4: creating a student invites a real Supabase
# Auth user (features/students/actions.ts), which needs this key. Never
# expose it to the browser (no NEXT_PUBLIC_ prefix, never import admin.ts
# from a Client Component).
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this app, used to build absolute links (e.g. the
# email confirmation redirect on signup). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
